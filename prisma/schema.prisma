// ApparelFlow ERP — Gatekeeper Verification System
// Prisma schema targeting Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") //
}

// ─── Enums ───────────────────────────────────────────────────────────

enum Role {
  cutting_supervisor
  cutting_verifier
  sewing_supervisor
}

enum OrderStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ComponentStatus {
  MATCH
  EXCESS
  SHORTAGE
}

// ─── Models ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  cuttingOrders    CuttingOrder[]
  verificationLogs VerificationLog[]

  @@map("users")
}

model Recipe {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  components    RecipeComponent[]
  cuttingOrders CuttingOrder[]

  @@map("recipes")
}

model RecipeComponent {
  id              String @id @default(uuid())
  recipeId        String @map("recipe_id")
  componentName   String @map("component_name")
  expectedQty     Int    @map("expected_qty")
  unit            String @default("pcs")

  recipe            Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  verificationItems VerificationItem[]

  @@unique([recipeId, componentName])
  @@map("recipe_components")
}

model CuttingOrder {
  id               String      @id @default(uuid())
  recipeId         String      @map("recipe_id")
  targetQty        Int         @map("target_qty")
  fabricRollId     String      @map("fabric_roll_id")
  actualFabricYards Float      @map("actual_fabric_yards")
  expectedFabricYards Float    @map("expected_fabric_yards")
  status           OrderStatus @default(PENDING_VERIFICATION)
  createdById      String?     @map("created_by_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  createdBy         User?              @relation(fields: [createdById], references: [id])
  verificationItems VerificationItem[]
  verificationLog   VerificationLog?

  @@map("cutting_orders")
}

model VerificationItem {
  id                String          @id @default(uuid())
  cuttingOrderId    String          @map("cutting_order_id")
  recipeComponentId String          @map("recipe_component_id")
  expectedQty       Int             @map("expected_qty")
  actualQty         Int?            @map("actual_qty")
  status            ComponentStatus?

  cuttingOrder    CuttingOrder    @relation(fields: [cuttingOrderId], references: [id], onDelete: Cascade)
  recipeComponent RecipeComponent @relation(fields: [recipeComponentId], references: [id])

  @@unique([cuttingOrderId, recipeComponentId])
  @@map("verification_items")
}

model VerificationLog {
  id              String      @id @default(uuid())
  cuttingOrderId  String      @unique @map("cutting_order_id")
  verifiedById    String?     @map("verified_by_id")
  action          String      // "APPROVED" or "REJECTED"
  rejectionNote   String?     @map("rejection_note")
  wastagePct      Float?      @map("wastage_pct")
  snapshotData    Json?       @map("snapshot_data") // immutable snapshot of component statuses
  createdAt       DateTime    @default(now()) @map("created_at")

  cuttingOrder CuttingOrder @relation(fields: [cuttingOrderId], references: [id])
  verifiedBy   User?        @relation(fields: [verifiedById], references: [id])

  @@map("verification_logs")
}
